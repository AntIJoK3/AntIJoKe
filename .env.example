# 复制此文件为 .env 并填入你自己的配置
# Copy this file to .env and fill in your own settings

# ---- Neo4j ----
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change_me

# ---- 数据集 ----
# DeepURLBench 风格 Parquet 所在目录（相对项目根目录）
DEEPURL_PARQUET_DIR=urls_with_dns_live_mixed/parts

# ---- 文本嵌入 ----
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
VECTOR_INDEX_NAME=content_vec_idx

# ---- 模型 ----
GNN_CHECKPOINT=artifacts/graphsage.pt
RANDOM_STATE=42

# ---- 图同构边（竖线分隔）----
# 扩展前请确保图中已存在对应关系类型，见 02_project_homogeneous.cypher
GRAPH_WEBSITE_HOMOG_EDGES=SHARED_IP|CONTENT_SIMILAR

# ---- 预警阈值 ----
FRAUD_ALERT_THRESHOLD=0.7
